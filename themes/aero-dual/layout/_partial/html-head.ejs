<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= page.description || '' %>">
  <meta name="author" content="<%= config.author || '' %>">
  <!-- Open Graph Data -->
  <meta property="og:title" content="<%= page.title || config.title || '' %>"/>
  <meta property="og:description" content="<%= page.description || config.description || '' %>" />
  <meta property="og:site_name" content="<%= config.title || '' %>"/>
  <meta property="og:type" content="<%= page.title ? 'article' : 'website' %>" />
  <meta property="og:image" content="<%= config.url %><%= config.cover %>"/>
  <% if (theme.rss) { %>
    <link rel="alternate" href="<%- theme.rss %>" title="<%= config.title %>" type="application/atom+xml">
  <% } %>
  <% if (theme.favicon) { %>
    <link rel="icon" href="<%- theme.favicon %>">
  <% } %>

  <!-- baidu verify -->
  <meta name="baidu-site-verification" content="LbIAzVLr6C" />
  <!-- Site Title -->
  <title><%- config.title %></title>

  <!-- Bootstrap CSS -->
  <%- css('css/bootstrap.min.css') %>
  <!-- Custom CSS -->
  <% var targetStyle = 'css/style.' + (config.theme_style || 'light') + '.css' %>
  <%- css(targetStyle) %>

  <!-- mermaid support -->
  <link href="<%- theme.CDN.mermaid_css %>" rel="stylesheet">
  <script src="<%- theme.CDN.mermaid_js %>"></script>
  
  <!-- highlight support -->
  <!-- <link href="<%- theme.CDN.highlight_css %>" rel="stylesheet"> -->
  <!-- <script src="<%- theme.CDN.highlight_js %>"></script> -->

  <!-- echarts support -->
  <script src="<%- theme.CDN.echarts_js %>"></script>


  <!-- Google Analytics -->
  <%- partial('google-analytics') %>
  
  <!-- Baidu Analytics -->
  <script>
  var _hmt = _hmt || [];
  (function() {
   var hm = document.createElement("script");
   hm.src = "https://hm.baidu.com/hm.js?6bf234a1bccd3985df2766fba5ba9277";
   var s = document.getElementsByTagName("script")[0]; 
   s.parentNode.insertBefore(hm, s);
   })();
  </script>

</head>
