<div id="container"></div>
<link rel="stylesheet" href="https://imsun.github.io/gitment/style/default.css">
<script src="https://imsun.github.io/gitment/dist/gitment.browser.js"></script>
<script>
var gitment = new Gitment({
    id: '<%= theme.comment.gitment_appid %>', // 可选。默认为 location.href
    owner: '<%= theme.comment.gitment_uid %>', // 可以是你的GitHub用户名，也可以是github id
    repo: '<%= theme.comment.gitment_repo %>',
    oauth: {
        client_id: '<%= theme.comment.gitment_clientid %>',
        client_secret: '<%= theme.comment.gitment_clientsecret %>',
    },
})
gitment.render('container')
</script>
